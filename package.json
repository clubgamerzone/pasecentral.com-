{
  "name": "pasecentral",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "bootstrap": "tsx --env-file-if-exists=.env.local scripts/bootstrap.ts",
    "worker": "tsx --env-file-if-exists=.env.local scripts/delivery.ts",
    "format": "prettier --write src scripts tests docs *.json *.ts *.mjs",
    "test:connected": "tsx --env-file-if-exists=.env.local scripts/verify-connected.ts",
    "worker:configure": "tsx --env-file-if-exists=.env.local scripts/configure-email-worker.ts"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "qz-tray": "2.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/qz-tray": "2.2.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "type": "module"
}
