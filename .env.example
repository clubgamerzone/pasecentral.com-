# npm run dev works without credentials, using persistent local PostgreSQL (PGlite).
# Development only. Never deploy APP_MODE=demo.
APP_MODE=demo
APP_URL=http://127.0.0.1:3000
# For real Supabase set APP_MODE=production and all required variables below.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Generate independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TICKET_ENCRYPTION_KEY=
SESSION_SECRET=
RESERVATION_MINUTES=10
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Resend HTTP adapter; verified sender required. Empty in demo => local outbox.
EMAIL_API_KEY=
EMAIL_FROM=
WORKER_SECRET=
NEXT_PUBLIC_QZ_PRINTER=
QZ_CERTIFICATE_PEM=
QZ_PRIVATE_KEY_PEM=
PRIVACY_TEXT=
PURCHASE_TERMS=
